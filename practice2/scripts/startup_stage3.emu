# Тестовый скрипт этапов 1-3 (все команды и ошибки)
# motd (если есть в VFS) выводится автоматически при старте

ls                      # заглушка без аргументов
ls -l /home/user        # заглушка с аргументами
cd /home                # заглушка cd
cd                      # cd без аргументов
cd a b c                # несколько аргументов
ls    много    пробелов # лишние пробелы игнорируются

unknown_cmd arg1        # ошибка: команда не найдена

exit
ls эта строка после exit не выполнится
